# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins (CORS).
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# MySQL. Local dev uses the Docker container described in README.md (port 3307).
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME
# Only for `prisma migrate dev` (local). Not needed in production.
SHADOW_DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME_shadow
# Used by `npm test`. The database name must end in _test; tests wipe it.
TEST_DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME_test

# Auth. Generate the secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=replace-with-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Optional: set when frontend and API share a parent domain, e.g. .vaharo.in
COOKIE_DOMAIN=
# bcrypt work factor (default 12) and auth rate limit per IP per 15 minutes (default 20).
BCRYPT_COST=12
AUTH_RATE_LIMIT_MAX=20

# Optional: password for `npm run db:seed` sample users (dev only).
SEED_DEMO_PASSWORD=

# Email. Without SMTP_HOST, development saves emails to tmp/outbox/*.eml; production refuses to start.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Vaharo
SMTP_FROM_EMAIL=

# Subscriptions. Free trial length and grace period after a failed payment.
TRIAL_DAYS=14
PAST_DUE_GRACE_DAYS=7
# Razorpay (leave empty to disable online checkout).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

APP_BASE_URL=http://localhost:5173
